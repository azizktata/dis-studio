# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Client source deliverables: ~103MB of PDFs that the site is built *from*,
# not served. Committing them made `git push` fail with HTTP 408 and would trip
# GitHub's file-size limits. The images the site actually uses are extracted
# into public/projets/ by scripts/extract-pdf-images.mjs and committed there.
/public/DIS STUDIO/
